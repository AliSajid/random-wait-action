#MISE description="Determine release target commit SHA"
set -euo pipefail

STATE_FILE="${RELEASE_STATE_FILE:-/tmp/release-state.env}"

# Source state from prepare/create-release-commit
if [ -f "$STATE_FILE" ]; then
        set -a
        # shellcheck source=/dev/null
        source "$STATE_FILE"
        set +a
fi

HAS_FILE_CHANGES="${has_file_changes:-false}"
RELEASE_COMMIT_SHA="${release_commit_sha:-}"

if [ "$HAS_FILE_CHANGES" = "true" ]; then
        TARGET_SHA="$RELEASE_COMMIT_SHA"
        if [ -z "$TARGET_SHA" ]; then
                echo "::error::Release commit SHA is empty. Commit creation may have failed."
                exit 1
        fi
        echo "Using newly-created release commit: $TARGET_SHA"
else
        TARGET_SHA="$(git rev-parse HEAD)"
        echo "No release file changes were needed. Using current branch HEAD as release target: $TARGET_SHA"
fi

echo "release_target_sha=$TARGET_SHA" >>"$STATE_FILE"
echo "sha=$TARGET_SHA" >>"${GITHUB_OUTPUT:-/dev/null}"
