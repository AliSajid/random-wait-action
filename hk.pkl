amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

// Generated, vendored, cached, and build output excluded from file-oriented steps.
local generated =
  List(
    "**/node_modules/**",
    "**/.astro/**",
    "**/.pnpm-store/**",
    "coverage/**",
    "website/dist/**",
    "dist/**",
  )

local prose = List("**/*.md", "**/*.mdx")
local workflows = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
local action_metadata = List("action.yml", "action.yaml", "**/action.yml", "**/action.yaml")

local hygiene = new Mapping<String, Step> {
  ["byte-order-marker"] = (Builtins.byte_order_marker) {
    exclude = generated
  }
  ["check-case-conflict"] = (Builtins.check_case_conflict) {}
  ["check-merge-conflict"] = (Builtins.check_merge_conflict) {}
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb 5120 {{files}}"
  }
  ["end-of-file-fixer"] = (Builtins.newlines) {
    exclude = generated + List("**/licenses/**/*.md", "**/licenses/**/*.hbs")
  }
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    exclude = generated + List("licenses_report.md")
  }
  ["crlf"] {
    glob = List("**/*")
    exclude = generated
    batch = true
    check = "mise run precommit:forbid_crlf -- {{files}}"
    fix = "mise run precommit:remove_crlf -- {{files}}"
  }
}

local formatters = new Mapping<String, Step> {
  ["prettier"] {
    glob =
      List(
        "**/*.astro",
        "**/*.css",
        "**/*.graphql",
        "**/*.html",
        "**/*.js",
        "**/*.json",
        "**/*.json5",
        "**/*.jsonc",
        "**/*.jsx",
        "**/*.md",
        "**/*.mdx",
        "**/*.mjs",
        "**/*.scss",
        "**/*.ts",
        "**/*.tsx",
        "**/*.yaml",
        "**/*.yml",
      )
    exclude = generated + List("CHANGELOG.md", "LICENSES/**")
    batch = true
    check = "pnpm exec prettier --check {{files}}"
    fix = "pnpm exec prettier --write {{files}}"
  }
  ["sort-package-json"] {
    glob = List("package.json", "**/package.json")
    exclude = generated
    batch = true
    check = "pnpm exec sort-package-json --check {{files}}"
    fix = "pnpm exec sort-package-json {{files}}"
  }
  ["mise-format"] {
    glob = List("mise.toml", ".mise.toml", "**/mise.toml", "**/.mise.toml")
    exclude = generated
    batch = true
    check = "mise fmt --check"
    fix = "mise fmt"
  }
}

local configuration_checks = new Mapping<String, Step> {
  ["taplo"] = (Builtins.taplo) {
    // mise owns formatting for its own configuration.
    exclude = generated + List("mise.toml", ".mise.toml", "**/mise.toml", "**/.mise.toml")
  }
  ["yamllint"] = (Builtins.yamllint) {
    exclude = generated
  }
  ["editorconfig"] = (Builtins.editorconfig_checker) {
    exclude = generated
  }
  ["renovate-config-validator"] {
    glob = List("renovate.json", ".github/renovate.json")
    stomp = true
    check = "renovate-config-validator --strict"
  }
}

local source_checks = new Mapping<String, Step> {
  ["eslint"] {
    glob = List("**/*.astro", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.ts", "**/*.tsx")
    exclude = generated
    batch = true
    check = "pnpm exec eslint {{files}}"
    fix = "pnpm exec eslint --fix {{files}}"
  }
  ["astro-check"] {
    glob =
      List(
        "website/src/**/*.astro",
        "website/src/**/*.mdx",
        "website/src/**/*.ts",
        "website/src/**/*.tsx",
      )
    exclude = generated
    stomp = true
    check = "pnpm --dir website exec astro check"
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = generated
  }
  // ["shfmt"] = (Builtins.shfmt) {
  //   exclude = generated
  // }
}

local github_actions_checks = new Mapping<String, Step> {
  // Syntax, expressions, action inputs, reusable workflows, and embedded scripts.
  ["actionlint"] {
    glob = workflows
    batch = true
    check = "actionlint {{files}}"
  }
  // Opinionated policy checks for workflow and action metadata security.
  ["ghalint-workflows"] {
    glob = workflows
    stomp = true
    check = "ghalint run"
  }
  ["ghalint-action"] {
    glob = action_metadata
    stomp = true
    check = "ghalint run-action"
  }
  // Verify immutable action references; Renovate remains responsible for updates.
  ["pinact"] {
    glob = workflows + action_metadata
    stomp = true
    check = "pinact run --verify"
  }
  // Broader CI/CD vulnerability analysis across workflows and action metadata.
  ["zizmor"] {
    glob = workflows + action_metadata + List(".github/dependabot.yml", ".github/dependabot.yaml")
    stomp = true
    check = "zizmor --min-severity medium ."
  }
}

local prose_checks = new Mapping<String, Step> {
  ["markdownlint"] {
    glob = prose
    exclude = generated + List("CHANGELOG.md", "LICENSES/**")
    batch = true
    check = "pnpm exec markdownlint-cli2 {{files}}"
  }
  ["vale"] {
    glob = prose
    exclude = generated + List("CHANGELOG.md", "LICENSES/**")
    batch = true
    check = "vale {{files}}"
  }
  ["fix-smartquotes"] = (Builtins.fix_smart_quotes) {
    glob = prose
    exclude = generated + List("CHANGELOG.md", "LICENSES/**")
  }
  ["fix-ligatures"] {
    glob = prose
    exclude = generated + List("CHANGELOG.md", "LICENSES/**")
    batch = true
    check = "fix-ligatures {{files}}"
    fix = "fix-ligatures {{files}}"
  }
  ["forbid-bidi-controls"] {
    glob = List("**/*")
    exclude = generated
    batch = true
    check = "forbid-bidi-controls {{files}}"
  }
}

local repository_checks = new Mapping<String, Step> {
  ["no-commit-to-protected-branch"] = (Builtins.no_commit_to_branch) {
    check = "hk util no-commit-to-branch --branch main --branch next"
  }
  ["gitleaks"] {
    glob = List("**/*")
    exclude = generated
    stomp = true
    check =
      "gitleaks git --no-banner --log-level warn --baseline-path .gitleaks_baseline.json --pre-commit"
  }
  ["reuse"] {
    glob = List("**/*")
    exclude = generated
    stomp = true
    check = "reuse lint"
  }
}

local fast_checks = new Mapping<String, Step> {
  ...hygiene
  ...formatters
  ...configuration_checks
  ...source_checks
  ...github_actions_checks
  ...prose_checks
  ...repository_checks
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commits"] = Builtins.cocogitto_commit_msg
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast_checks
  }
  ["pre-push"] {
    steps = fast_checks
  }
  ["check"] {
    steps = fast_checks
  }
  ["fix"] {
    fix = true
    steps = fast_checks
  }
}
