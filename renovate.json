{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "assignees": [
        "AliSajid"
    ],
    "baseBranchPatterns": [
        "next"
    ],
    "extends": [
        "config:best-practices",
        "group:definitelyTyped",
        "group:linters",
        ":pinDependencies",
        ":reviewer(AliSajid)"
    ],
    "labels": [
        "dependencies",
        "renovate"
    ],
    "packageRules": [
        {
            "automerge": true,
            "description": "Automerge GitHub Actions digest and patch updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "digest",
                "patch"
            ],
            "minimumReleaseAge": "14 days"
        },
        {
            "dependencyDashboardApproval": true,
            "description": "Require dashboard approval for GitHub Actions minor and major updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "minor",
                "major"
            ]
        },
        {
            "automerge": true,
            "description": "Automerge non-major linting, formatting, and test-tool updates",
            "matchDepTypes": [
                "devDependencies"
            ],
            "matchPackageNames": [
                "@eslint/**",
                "@eslint-community/**",
                "@stylistic/eslint-plugin**",
                "@typescript-eslint/**",
                "eslint**",
                "typescript-eslint",
                "prettier",
                "prettier-**",
                "@vitest/**",
                "vitest"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "minimumReleaseAge": "14 days"
        }
    ],
    "platformCommit": "enabled",
    "schedule": [
        "* 22-23,0-4 * * 1-5",
        "* * * * 0,6"
    ],
    "semanticCommits": "enabled",
    "separateMinorPatch": true
}
